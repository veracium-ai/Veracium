     "table": "wiki",
     "op": "INSERT OR REPLACE",
     "what": "the recall's wiki cache publication, inherited",
     "condition": "the query path with wiki recompilation enabled (MemoryConfig.wiki_recompile_after_writes > 0; default 8): one row, empty user or not; the no-query proactive path: none; recompilation 0: none (both seats measured, v0.14.1)",
