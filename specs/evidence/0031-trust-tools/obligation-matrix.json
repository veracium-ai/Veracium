    "path": "query | proactive",
    "units": [
     {
      "kind": "edge | episode | wiki",
      "id": "id or null (wiki)",
      "text": "as admitted by the renderer",
      "partition": "grounded | fenced | contested",
      "subject": "present iff not the user",
      "annotations": "stale, extraction-error, contested, challenge",
      "mutable": "present iff a principal is bound"
