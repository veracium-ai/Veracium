  "mcp": {
   "principal": null,
   "call_path": "mcp_direct",
   "source_id": "build_server's configured source_id (default None) (TT-R2-03)"
  },
  "adapter.langchain": {
   "principal": "the host's, bound at construction",
   "call_path": "adapter_direct"
  },
  "adapter.pydantic_ai": {
   "principal": "the host's, bound at construction",
   "call_path": "adapter_direct"
  }
 },
 "gate_order": [
  "capability: not direct -> attempted_elevation",
  "erasure off (forget tools) -> erasure_disabled",
  "principal bound (whole-user tools) -> principal_scoped",
  "input validation -> named refusal (reason_too_long; exactly one id; token strict parse -> preview_unknown)",
  "scope configuration (principal) -> scope_unconfigured / principal_ungroupable",
  "binding source (principal; correct/dispute/confirm) -> source_unbound / source_out_of_scope",
  "target scope (principal) -> not_found_in_scope (CROSS_HIDDEN, UNRESOLVED, other user, unknown; identical response) / out_of_scope (SHARED, CROSS_VISIBLE)",
  "library refusals (ValueError, TypeError, CorrectionRefused, ScopeError)"
 ],
