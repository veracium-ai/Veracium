+def test_i13_old_reader_refuses_exactly(tmp_path):
+    db = str(tmp_path / "future.db")
+    s = SqliteStore(db)
+    s.add_edge(_edge("x", author=EvidenceAuthor.USER))
+    s._conn.execute(f"PRAGMA user_version = {sv.SCHEMA_VERSION + 1}")
+    s._conn.commit()
+    s.close()
+    with pytest.raises(sv.StoreVersionError) as ei:
+        SqliteStore(db)
+    assert ei.value.reason == "newer"
