+# ---- I13: the migration matrix ---------------------------------------------
+
+def test_i13a_schema_v11_is_byte_identical_to_v10():
+    assert sv.SCHEMA_V11 == sv.SCHEMA_V10
+    assert sv.SCHEMA_VERSION == 11
+
+
+def _v10_store(path, route):
+    """Construct a v10-form store by ROUTE, yielding distinct accepted
+    manifestations (the migrated shapes materialise via the real
+    migrations)."""
+    conn = sqlite3.connect(path)
+    if route == "constructor-v10":
+        for o in sv.SCHEMA_V10:
+            conn.execute(o.ddl)
+        conn.execute("PRAGMA user_version = 10")
+    elif route == "v6-base":
+        for o in sv.SCHEMA_V6:
+            conn.execute(o.ddl)
+        conn.execute("PRAGMA user_version = 6")
+    elif route == "v9-base":
+        for o in sv.SCHEMA_V9:
+            conn.execute(o.ddl)
+        conn.execute("PRAGMA user_version = 9")
+    conn.commit()
+    conn.close()
+
+
+@pytest.mark.parametrize("route", ["constructor-v10", "v6-base", "v9-base"])
+def test_i13b_migration_to_v11_is_stamp_only_past_v10(route, tmp_path):
+    """Whatever route reaches v10 form, the v10->v11 EDGE is stamp-only:
+    the schema dump is byte-identical across that edge and the store lands
+    accepted at 11."""
+    db = str(tmp_path / f"{route}.db")
+    _v10_store(db, route)
+    migrate_store(db)
+    conn = sqlite3.connect(db)
+    assert conn.execute("PRAGMA user_version").fetchone()[0] == 11
+    dump = sorted(r[0] or "" for r in conn.execute(
+        "SELECT sql FROM sqlite_master").fetchall())
+    conn.close()
+    # the same route stopped at 10 (simulated by re-running the pre-11
+    # construction) must dump identically: the 10->11 edge added nothing
+    db10 = str(tmp_path / f"{route}-at10.db")
+    _v10_store(db10, route)
+    if route != "constructor-v10":
+        # drive the legacy base up THROUGH v10 by the real migration, then
+        # compare shapes — migrate_store now lands at 11 with the same SQL
+        migrate_store(db10)
+    c2 = sqlite3.connect(db10)
+    dump10 = sorted(r[0] or "" for r in c2.execute(
+        "SELECT sql FROM sqlite_master").fetchall())
+    c2.close()
+    assert dump == dump10, f"{route}: the v10->v11 edge changed SQL shape"
+    # and the result is ACCEPTED at 11
+    s = SqliteStore(db)
+    s.close()
+
+
+def test_i13c_v11_inherits_every_v10_manifestation():
+    v10 = sv.accepted_digests(10)
+    v11 = sv.accepted_digests(11)
+    # DERIVED, never typed: the v11 set is exactly as large as v10's —
+    # the same five-shape construction digested at 11
+    assert len(v10) == 5, "the v10 domain moved; re-derive this test"
+    assert len(v11) == len(v10), (
+        "v11 must inherit EVERY accepted v10 manifestation")
+
