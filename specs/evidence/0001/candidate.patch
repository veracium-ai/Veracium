+# ---- I13: the migration matrix ---------------------------------------------
+
+def test_i13a_schema_v11_is_byte_identical_to_v10():
+    assert sv.SCHEMA_V11 == sv.SCHEMA_V10
+    assert sv.SCHEMA_VERSION == 11
